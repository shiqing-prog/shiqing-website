{
  "name": "personal-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "shiqing.site", "custom_domain": true },
    { "pattern": "www.shiqing.site", "custom_domain": true },
    // 文档站：同一份 Worker 的第二个自定义域名（部署时 wrangler 自动建 DNS 记录）
    { "pattern": "docs.shiqing.site", "custom_domain": true },
    // API 专用域名：路径由 src/middleware.ts 重写进 /api/v1/*，见该文件注释
    { "pattern": "api.shiqing.site", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "dsh_bbs",
      "database_name": "dsh-bbs",
      "database_id": "e54b37fa-8886-4115-9409-fadd9382d769"
    }
  ],
  "vars": {
    "FILE_PUBLIC_BASE": "https://files.shiqing.site",
    // 邮箱验证：QQ 邮箱 SMTP 中继（本机 mail-relay:9091，经 mail.shiqing.site 隧道暴露）
    "MAILER_BASE": "https://mail.shiqing.site",
    "VERIFY_EMAIL": "true",
    // 第三方数据接口（/api/v1/<能力路径>）：上游地址公开，令牌走 wrangler secret 的 UAPI_TOKEN
    "UAPI_BASE": "https://uapis.cn",
    // B 站接口中转：机房出口被平台按 IP 整段风控，绕回家宽云隧道再出去（令牌走 secret BILI_PROXY_KEY）
    "BILI_PROXY_BASE": "https://files.shiqing.site"
  }
}