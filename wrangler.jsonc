{
  "name": "personal-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "shiqing.site", "custom_domain": true },
    { "pattern": "www.shiqing.site", "custom_domain": true }
  ]
}
