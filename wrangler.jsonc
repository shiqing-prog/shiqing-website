{
  "name": "personal-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "shiqing.site", "custom_domain": true },
    { "pattern": "www.shiqing.site", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "dsh_bbs",
      "database_name": "dsh-bbs",
      "database_id": "e54b37fa-8886-4115-9409-fadd9382d769"
    }
  ],
  "vars": {
    "FILE_PUBLIC_BASE": "https://files.shiqing.site",
    "VERIFY_EMAIL": "false"
  }
}
