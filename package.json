{
  "name": "personal-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:psych": "tsc src/lib/psych/types.ts src/lib/psych/scoring.ts src/lib/psych/scales.ts --outDir .tmp-psych --module commonjs --target es2020 --skipLibCheck && node scripts/psych-selftest.js .tmp-psych",
    "build:cf": "opennextjs-cloudflare build",
    "deploy:cf": "opennextjs-cloudflare build && wrangler deploy",
    "cf:login": "wrangler login",
    "cf:dev": "wrangler dev"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "markdown-it": "^15.0.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
